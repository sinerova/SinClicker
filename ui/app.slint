import { Button, ComboBox, HorizontalBox, SpinBox, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "SinClicker";
    preferred-width: 360px;
    preferred-height: 310px;

    in property <bool> running: false;
    in property <string> input-error: "";
    // Populated from the Rust catalog (`settings::SUPPORTED_HOTKEYS`) before
    // the event loop starts, so the ComboBox order and the Rust index
    // mapping can never drift apart.
    in property <[string]> hotkey-model;
    in-out property <int> hotkey-index: 0;
    in-out property <int> cps: 10;
    // The nominal interval per click (1000 / CPS) in milliseconds, kept in
    // sync by Rust from the same validated CPS value the worker uses.
    in property <string> target-interval: "100 ms";

    callback toggle-clicking();
    callback cps-changed(value: int);
    callback hotkey-changed(display: string);

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "SinClicker";
            font-size: 20px;
            font-weight: FontWeight.semi-bold;
        }

        Text {
            text: "Auto left-clicks at the current pointer position.";
            wrap: word-wrap;
        }

        Text {
            text: running ? "Clicking" : "Stopped";
            font-size: 14px;
            font-weight: FontWeight.semi-bold;
        }

        Text {
            visible: input-error != "";
            text: input-error;
            wrap: word-wrap;
            font-size: 12px;
        }

        Button {
            text: running ? "Stop" : "Start";
            height: 36px;
            clicked => {
                toggle-clicking();
            }
        }

        HorizontalBox {
            spacing: 8px;
            Text {
                text: "Clicks per second";
                vertical-alignment: center;
            }
            // Composite: the SpinBox fills an otherwise-transparent Rectangle,
            // and the nominal target interval is drawn beside the value inside
            // the same control. The SpinBox internals (fluent style) are
            // `padding-left 12px | left-aligned value | chevrons 28px x 2 +
            // 4px spacing | padding-right 2px`, so the value text occupies the
            // left of the control and the right strip inside the border is
            // free; the parenthetical is anchored there, right of the value
            // and 6px clear of the chevrons. A plain Text takes no focus and
            // catches no input, so editing and the SpinBox's keyboard/button
            // handling are unaffected.
            Rectangle {
                horizontal-stretch: 1;
                SpinBox {
                    width: 100%;
                    height: 100%;
                    minimum: 1;
                    maximum: 500;
                    step-size: 1;
                    value <=> cps;
                    edited(value) => {
                        cps-changed(value);
                    }
                }
                Text {
                    x: parent.width - 68px - self.width;
                    vertical-alignment: center;
                    text: " (" + target-interval + ")";
                    font-size: 12px;
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Text {
                text: "Toggle hotkey";
                vertical-alignment: center;
            }
            ComboBox {
                horizontal-stretch: 1;
                model: hotkey-model;
                current-index <=> hotkey-index;
                selected(display) => {
                    hotkey-changed(display);
                }
            }
        }
    }
}
