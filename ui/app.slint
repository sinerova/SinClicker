import { Button, Palette, SpinBox } from "std-widgets.slint";

// Small shared visual language. Neutral colors come from the Slint Palette so
// the window follows the system light/dark setting; only the two status
// colors are custom, each defined once per color scheme.
global Ui {
    out property <length> pad: 20px;
    out property <length> gap: 16px;
    out property <length> control-height: 36px;
    out property <length> label-width: 112px;
    out property <length> radius: 6px;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> running: dark ? #6ccb5f : #107c10;
    out property <color> error: dark ? #ff99a4 : #c42b1c;
    out property <color> muted: Palette.foreground.with-alpha(0.7);
}

// One key of a shortcut, drawn as a small keycap.
component KeyCap inherits Rectangle {
    in property <string> text;
    width: max(24px, label.preferred-width + 14px);
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.alternate-background;
    label := Text {
        text: root.text;
        font-size: 12px;
        font-weight: FontWeight.semi-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Palette.foreground;
    }
}

// Shows the current shortcut as keycaps; click it (or focus it and press
// Space/Enter) to record a new one. While recording, every key press is
// forwarded through `captured` except bare modifiers (still being held) and a
// plain Escape (cancels). Losing focus also cancels. Validation and
// registration happen in Rust, which ends recording on success.
component ShortcutField {
    in property <[string]> keys;
    in property <string> display;
    in-out property <bool> recording;
    callback captured(text: string, ctrl: bool, alt: bool, shift: bool, meta: bool);

    forward-focus: scope;
    accessible-role: button;
    accessible-label: "Toggle hotkey";
    accessible-description: recording ? "Press a new shortcut, or Escape to cancel" : display;
    accessible-action-default => {
        scope.focus();
        root.recording = true;
    }

    Rectangle {
        border-radius: Ui.radius;
        border-width: root.recording || scope.has-focus ? 2px : 1px;
        border-color: root.recording || scope.has-focus ? Palette.accent-background : Palette.border;
        background: touch.has-hover && !root.recording ? Palette.alternate-background : Palette.control-background;
    }

    scope := FocusScope {
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                scope.focus();
                root.recording = true;
            }
        }

        changed has-focus => {
            if !self.has-focus {
                root.recording = false;
            }
        }
        key-pressed(event) => {
            if !root.recording {
                if event.text == Key.Space || event.text == Key.Return {
                    root.recording = true;
                    return accept;
                }
                return reject;
            }
            if event.repeat {
                return accept;
            }
            if event.text == Key.Escape && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta {
                root.recording = false;
                return accept;
            }
            if event.text == Key.Shift || event.text == Key.ShiftR || event.text == Key.Control || event.text == Key.ControlR || event.text == Key.Alt || event.text == Key.AltGr || event.text == Key.Meta || event.text == Key.MetaR || event.text == Key.CapsLock {
                return accept;
            }
            root.captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            accept
        }
    }

    HorizontalLayout {
        padding: 6px;
        padding-left: 8px;
        padding-right: 12px;
        spacing: 4px;
        for key in root.recording ? [] : root.keys: KeyCap {
            text: key;
        }
        if root.recording: Text {
            text: "Press a shortcut…";
            vertical-alignment: center;
            color: Ui.muted;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: root.recording ? "Esc to cancel" : "Change";
            font-size: 12px;
            vertical-alignment: center;
            color: Ui.muted;
        }
    }
}

export component MainWindow inherits Window {
    title: "SinClicker";
    preferred-width: 400px;
    preferred-height: 264px;
    min-width: 360px;
    min-height: 264px;
    background: Palette.background;

    in property <bool> running: false;
    in property <string> input-error: "";
    // The active binding, set by Rust from the registered `HotkeyChoice`:
    // its parts (shown as keycaps) and its full display string.
    in property <[string]> hotkey-keys: ["Ctrl", "Alt", "F6"];
    in property <string> hotkey-display: "Ctrl+Alt+F6";
    // True while the shortcut field is waiting for a new combination.
    in-out property <bool> hotkey-recording: false;
    // Why the last captured combination was refused; shown while recording.
    in-out property <string> hotkey-problem: "";
    in-out property <int> cps: 10;
    // The supported range, set from `clicker::MIN_CPS`/`MAX_CPS` so the UI and
    // the Rust-side clamp share one definition.
    in property <int> min-cps: 1;
    in property <int> max-cps: 500;
    // The nominal interval per click (1000 / CPS) in milliseconds, kept in
    // sync by Rust from the same validated CPS value the worker uses.
    in property <string> target-interval: "100 ms";

    callback toggle-clicking();
    callback cps-changed(value: int);
    callback hotkey-captured(text: string, ctrl: bool, alt: bool, shift: bool, meta: bool);
    callback hotkey-recording-changed(recording: bool);

    changed hotkey-recording => {
        hotkey-problem = "";
        hotkey-recording-changed(hotkey-recording);
    }

    VerticalLayout {
        padding: Ui.pad;
        spacing: Ui.gap;
        alignment: start;

        // Header: identity on the left, live state on the right.
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: "SinClicker";
                    font-size: 22px;
                    font-weight: FontWeight.semi-bold;
                    color: Palette.foreground;
                }
                Text {
                    text: "Auto left-clicks at the current pointer position.";
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Ui.muted;
                }
            }
            Rectangle {
                width: status-row.preferred-width + 20px;
                height: 26px;
                y: 4px;
                border-radius: self.height / 2;
                border-width: 1px;
                border-color: running ? Ui.running : Palette.border;
                background: running ? Ui.running.with-alpha(0.14) : transparent;
                status-row := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: running ? Ui.running : Ui.muted;
                    }
                    Text {
                        text: running ? "Clicking" : "Stopped";
                        font-size: 12px;
                        font-weight: FontWeight.semi-bold;
                        vertical-alignment: center;
                        color: Palette.foreground;
                    }
                }
            }
        }

        Button {
            text: running ? "Stop" : "Start";
            primary: !running;
            height: 40px;
            clicked => {
                toggle-clicking();
            }
        }

        if input-error != "": Rectangle {
            border-radius: Ui.radius;
            border-width: 1px;
            border-color: Ui.error;
            background: Ui.error.with-alpha(0.12);
            VerticalLayout {
                padding: 8px;
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: input-error;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Palette.foreground;
                }
            }
        }

        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;
                height: Ui.control-height;
                Text {
                    width: Ui.label-width;
                    text: "Clicks per second";
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                // Composite: the SpinBox fills an otherwise-transparent Rectangle,
                // and the nominal target interval is drawn beside the value inside
                // the same control. The SpinBox internals (fluent style) are
                // `padding-left 12px | left-aligned value | chevrons 28px x 2 +
                // 4px spacing | padding-right 2px`, so the value text occupies the
                // left of the control and the right strip inside the border is
                // free; the parenthetical is anchored there, right of the value
                // and 6px clear of the chevrons. A plain Text takes no focus and
                // catches no input, so editing and the SpinBox's keyboard/button
                // handling are unaffected.
                Rectangle {
                    horizontal-stretch: 1;
                    SpinBox {
                        width: 100%;
                        height: 100%;
                        minimum: min-cps;
                        maximum: max-cps;
                        step-size: 1;
                        value <=> cps;
                        edited(value) => {
                            cps-changed(value);
                        }
                    }
                    Text {
                        x: parent.width - 68px - self.width;
                        vertical-alignment: center;
                        text: "(" + target-interval + ")";
                        font-size: 12px;
                        color: Ui.muted;
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 12px;
                    height: Ui.control-height;
                    Text {
                        width: Ui.label-width;
                        text: "Toggle hotkey";
                        vertical-alignment: center;
                        color: Palette.foreground;
                    }
                    ShortcutField {
                        horizontal-stretch: 1;
                        keys: hotkey-keys;
                        display: hotkey-display;
                        recording <=> hotkey-recording;
                        captured(text, ctrl, alt, shift, meta) => {
                            hotkey-captured(text, ctrl, alt, shift, meta);
                        }
                    }
                }
                // Guidance while recording, aligned under the field.
                if hotkey-recording: HorizontalLayout {
                    padding-left: Ui.label-width + 12px;
                    Text {
                        text: hotkey-problem != "" ? hotkey-problem : "Hold Ctrl or Alt and press a key.";
                        wrap: word-wrap;
                        font-size: 12px;
                        color: hotkey-problem != "" ? Ui.error : Ui.muted;
                    }
                }
            }
        }
    }
}